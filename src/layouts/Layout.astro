---
import '../styles/global.css';
import { SUPPORTED_LANGUAGES } from '../data/i18n';

export interface Props {
	title: string;
	description: string;
	path?: string;
	noindex?: boolean;
	jsonLd?: Record<string, unknown>[];
}

const {
	title,
	description,
	path = Astro.url.pathname,
	noindex = false,
	jsonLd = [],
} = Astro.props;

const SITE = 'https://tipcalculatorwithtax.com';
const canonical = new URL(path, SITE).toString();
const ogImage = new URL('/og-image.png', SITE).toString();
---

<!doctype html>
<html lang="en" data-theme="light">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="TipCalculator" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="canonical" href={canonical} />
		<meta name="generator" content={Astro.generator} />

		<!-- International SEO hreflang tags -->
		<link rel="alternate" hreflang="x-default" href={canonical} />
		{
			SUPPORTED_LANGUAGES.map((lang) => (
				<link
					rel="alternate"
					hreflang={lang.code}
					href={`${SITE}${path}?lang=${lang.code}`}
				/>
			))
		}

		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<meta name="theme-color" content="#e8ebe6" />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Tip Calculator With Tax" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:alt" content="Tip Calculator With Tax & Bill Splitter interface preview" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<!-- Preconnect fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Manrope:wght@800;900&family=JetBrains+Mono:wght@400;500;600&display=swap"
		/>

		<!-- Structured Data (JSON-LD) -->
		{
			jsonLd.map((schema) => (
				<script type="application/ld+json" set:html={JSON.stringify(schema)} />
			))
		}

		<!-- Instant Theme & Language Restore to prevent flash -->
		<script is:inline>
			(function () {
				try {
					var storedTheme = localStorage.getItem('stc-theme');
					var theme =
						storedTheme === 'light' || storedTheme === 'dark'
							? storedTheme
							: window.matchMedia('(prefers-color-scheme: dark)').matches
								? 'dark'
								: 'light';
					document.documentElement.dataset.theme = theme;

					var storedLang = localStorage.getItem('stc-lang');
					var params = new URLSearchParams(window.location.search);
					var urlLang = params.get('lang');
					var lang = urlLang || storedLang || 'en';
					document.documentElement.lang = lang;
					document.documentElement.dir = lang === 'ar' ? 'rtl' : 'ltr';
				} catch (e) {
					document.documentElement.dataset.theme = 'light';
					document.documentElement.lang = 'en';
				}
			})();
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to main content</a>
		<slot />
		<script>
			import '../scripts/app.ts';
		</script>

		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-MXQZHHX20F"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());

			gtag('config', 'G-MXQZHHX20F');
		</script>
	</body>
</html>
