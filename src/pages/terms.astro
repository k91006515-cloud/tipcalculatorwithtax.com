---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
	title="Terms of Use — Tip Calculator With Tax"
	description="The terms that apply when you use the free Tip Calculator With Tax web app."
	path="/terms/"
>
	<Header />
	<main id="main" class="page">
		<div class="container page__inner">
			<p class="eyebrow">Legal</p>
			<h1 class="page__title">Terms of use</h1>
			<p class="page__meta">Last updated: 20 October 2026</p>

			<div class="prose">
				<h2>Using the calculator</h2>
				<p>
					Tip Calculator With Tax is provided free of charge for personal and commercial use. By
					using the site you agree to these terms. If you do not agree to them, please stop
					using the site.
				</p>

				<h2>No warranty</h2>
				<p>
					The calculator is provided “as is”, without warranties of any kind, express or
					implied, including but not limited to implied warranties of merchantability,
					fitness for a particular purpose and non-infringement. Results are produced by
					automated rounding rules and should be double-checked before money changes hands.
				</p>

				<h2>Limitation of liability</h2>
				<p>
					To the fullest extent permitted by law, the operators of this site are not liable for
					any indirect, incidental, special or consequential damages arising from your use of,
					or inability to use, the site — including rounding differences, currency
					conversion issues or amounts that differ from what a restaurant, driver or other
					provider charges.
				</p>

				<h2>Accuracy of the tip guide</h2>
				<p>
					Tipping norms change from place to place and from one service to another. The guide on
					the home page reflects common United States practice and is provided for general
					guidance only.
				</p>

				<h2>Intellectual property</h2>
				<p>
					The design, code and content of this site belong to the operators of
					tipcalculatorwithtax.com. You are welcome to link to the site and share links to it,
					but you may not copy or republish the calculator as your own product.
				</p>

				<h2>Changes</h2>
				<p>
					We may update these terms from time to time. Continued use of the site after a change
					means you accept the revised terms.
				</p>

				<h2>Contact</h2>
				<p>
					Questions can be sent to
					<a href="mailto:hello@tipcalculatorwithtax.com">hello@tipcalculatorwithtax.com</a>.
				</p>
			</div>
		</div>
	</main>
	<Footer />
</Layout>
