---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TipCalculator from '../components/TipCalculator.astro';
import Faq from '../components/Faq.astro';

const steps = [
	{
		number: '01',
		titleKey: 'step1Title',
		title: '1. Enter bill & tax',
		descKey: 'step1Desc',
		desc: 'Type your subtotal from the receipt, or tap a quick amount. Add your local sales tax rate if your bill is pre-tax.',
	},
	{
		number: '02',
		titleKey: 'step2Title',
		title: '2. Choose your tip',
		descKey: 'step2Desc',
		desc: 'Pick a standard preset (10%, 15%, 18%, 20%, 25%) or type any exact custom percentage you prefer.',
	},
	{
		number: '03',
		titleKey: 'step3Title',
		title: '3. Split & settle up',
		descKey: 'step3Desc',
		desc: 'Set the number of people sharing the check. See exactly what each person owes, with optional clean rounding.',
	},
];

const features = [
	{
		titleKey: 'feat1Title',
		title: '40+ World Currencies',
		descKey: 'feat1Desc',
		desc: 'Switch between USD, EUR, GBP, INR, CAD, AUD, JPY and dozens more with authentic locale currency formatting.',
		icon: 'globe',
	},
	{
		titleKey: 'feat2Title',
		title: 'Flexible Tip Options',
		descKey: 'feat2Desc',
		desc: 'Quick preset buttons from 0% to 50% plus a custom percentage field for exact custom tip amounts.',
		icon: 'percent',
	},
	{
		titleKey: 'feat3Title',
		title: 'Accurate Bill Splitting',
		descKey: 'feat3Desc',
		desc: 'Divide food, tax, and tip fairly among solo diners or large parties with visual split indicators.',
		icon: 'users',
	},
	{
		titleKey: 'feat4Title',
		title: 'Clean Rounding Options',
		descKey: 'feat4Desc',
		desc: 'Avoid annoying pocket coins by rounding per-person totals cleanly up, down, or to the nearest whole currency unit.',
		icon: 'check',
	},
	{
		titleKey: 'feat5Title',
		title: 'Light & Dark Mode',
		descKey: 'feat5Desc',
		desc: 'Modern high-contrast theme designed for bright outdoor lunches or dim evening restaurant lighting.',
		icon: 'moon',
	},
	{
		titleKey: 'feat6Title',
		title: '100% Private & Offline',
		descKey: 'feat6Desc',
		desc: 'Calculations run entirely in your browser. No sign-up, no analytics tracking your dollar amounts, works offline.',
		icon: 'shield',
	},
];

const usTipGuide = [
	{ serviceKey: 'serviceSitDown', service: 'Sit-down restaurant dining', tip: '18% – 20%' },
	{ serviceKey: 'serviceBuffet', service: 'Buffet / Casual dining', tip: '10% – 15%' },
	{ serviceKey: 'serviceBar', service: 'Cocktail bar & Bartender', tip: '$1 – $2/drink or 15–20%' },
	{ serviceKey: 'serviceDelivery', service: 'Food delivery (DoorDash, Uber Eats)', tip: '10% – 15% (min $3–$5)' },
	{ serviceKey: 'serviceCoffee', service: 'Coffee shop / Counter service', tip: 'Optional / $1' },
	{ serviceKey: 'serviceTaxi', service: 'Taxi or Rideshare (Uber, Lyft)', tip: '10% – 15%' },
	{ serviceKey: 'serviceSalon', service: 'Hair salon, Barber, Spa', tip: '15% – 20%' },
	{ serviceKey: 'serviceHousekeeping', service: 'Hotel housekeeping (per night)', tip: '$2 – $5' },
	{ serviceKey: 'serviceValet', service: 'Valet parking (upon car return)', tip: '$2 – $5' },
	{ serviceKey: 'serviceTourGuide', service: 'Tour guide (daily excursions)', tip: '10% – 15%' },
];

const internationalGuide = [
	{
		regionKey: 'regionUsCanada',
		region: 'United States & Canada',
		normKey: 'normUsCanada',
		norm: '15% – 20%',
		detailsKey: 'detailsUsCanada',
		details: 'Expected. Servers depend on tips as the majority of their income. 18-20% is standard.',
	},
	{
		regionKey: 'regionEuropeUk',
		region: 'UK & European Union',
		normKey: 'normEuropeUk',
		norm: '10% – 12.5%',
		detailsKey: 'detailsEuropeUk',
		details: 'Discretionary. Many European restaurants include a service charge (service compris).',
	},
	{
		regionKey: 'regionAsiaJapan',
		region: 'Japan & South Korea',
		normKey: 'normAsiaJapan',
		norm: '0% (No tipping)',
		detailsKey: 'detailsAsiaJapan',
		details: 'Do not tip. Exceptional service is included. Leaving cash can cause confusion or be politely refused.',
	},
	{
		regionKey: 'regionIndiaSouthAsia',
		region: 'India & South Asia',
		normKey: 'normIndiaSouthAsia',
		norm: '5% – 10%',
		detailsKey: 'detailsIndiaSouthAsia',
		details: 'Customary in restaurants unless a mandatory "Service Charge" (typically 10%) is already on the bill.',
	},
	{
		regionKey: 'regionAustraliaNz',
		region: 'Australia & New Zealand',
		normKey: 'normAustraliaNz',
		norm: '0% – 10%',
		detailsKey: 'detailsAustraliaNz',
		details: 'Not expected because hospitality staff earn fair living wages. 5-10% is appreciated for outstanding service.',
	},
	{
		regionKey: 'regionLatinAmerica',
		region: 'Mexico & Latin America',
		normKey: 'normLatinAmerica',
		norm: '10% – 15%',
		detailsKey: 'detailsLatinAmerica',
		details: 'Customary (called "propina"). Some restaurants print suggested amounts on the ticket.',
	},
];

const faqItems = [
	{
		qKey: 'faq1Q',
		question: 'How much should I tip at a restaurant?',
		aKey: 'faq1A',
		answer:
			'In the United States and Canada, 18% to 20% is the standard for good sit-down table service, with 15% as a minimum for acceptable service and 22–25% for exceptional hospitality. In the UK and Europe, 10% to 12.5% is customary if a service charge is not already included on the receipt.',
	},
	{
		qKey: 'faq2Q',
		question: 'Should I calculate tip before or after tax?',
		aKey: 'faq2A',
		answer:
			'Proper etiquette suggests tipping on the pre-tax food and beverage total, because tax is a government fee rather than hospitality service. However, many diners tip on the final total for convenience. Our calculator lets you enter both the subtotal and your tax percentage so you can see exact numbers both ways.',
	},
	{
		qKey: 'faq3Q',
		question: 'How does the per-person split work with tax and tip?',
		aKey: 'faq3A',
		answer:
			'The calculator takes your bill amount, adds the calculated sales tax and tip amount to get the grand total, and divides that grand total equally by the number of people. If rounding is enabled, it cleanly rounds each person’s share to a whole currency unit.',
	},
	{
		qKey: 'faq4Q',
		question: 'How does rounding up or down work?',
		aKey: 'faq4A',
		answer:
			'When splitting bills among multiple friends, decimals can create awkward coin amounts. "Round up" raises each person’s share to the next whole currency unit (e.g., $18.35 becomes $19.00), leaving a slight positive tip surplus. "Round down" drops down to the whole unit, and "Nearest" rounds to the closest whole unit.',
	},
	{
		qKey: 'faq5Q',
		question: 'Which world currencies are supported?',
		aKey: 'faq5A',
		answer:
			'We support 40+ major global currencies including USD ($), EUR (€), GBP (£), INR (₹), CAD ($), AUD ($), JPY (¥), CHF, MXN ($), BRL (R$), AED (د.إ), and more. Zero-decimal currencies like Japanese Yen are handled natively without unnecessary cents.',
	},
	{
		qKey: 'faq6Q',
		question: 'Can I share the calculated split with friends?',
		aKey: 'faq6A',
		answer:
			'Yes! Click the "Copy link" button to generate a clean shareable link with your bill, tip percentage, tax, and party size pre-filled. Anyone who opens the link will see the exact same calculation.',
	},
	{
		qKey: 'faq7Q',
		question: 'Does this calculator work offline?',
		aKey: 'faq7A',
		answer:
			'Yes. The application runs 100% client-side in your mobile or desktop browser. Once loaded, it works without an active internet connection, making it perfect for international travel, flights, and restaurants with poor cell reception.',
	},
	{
		qKey: 'faq8Q',
		question: 'Is my financial data or receipt info saved on your servers?',
		aKey: 'faq8A',
		answer:
			'No. We respect your complete privacy. Calculations happen exclusively inside your device memory. We do not store or transmit your bill totals, party size, or payment details. Only your chosen preferences (currency, language, theme) are remembered locally in your own browser.',
	},
];

const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebApplication',
		name: 'Tip Calculator With Tax',
		url: 'https://tipcalculatorwithtax.com/',
		applicationCategory: 'FinanceApplication',
		operatingSystem: 'Any',
		description:
			'Free online tip calculator with tax support, bill splitting, 40+ world currencies, custom percentages, rounding options, and dark mode.',
		offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
		featureList: [
			'Calculate tip on pre-tax subtotal or total bill',
			'Split bills equally between 1 to 999 people',
			'Support for 40+ global currencies (USD, EUR, GBP, INR, CAD, AUD, JPY, etc.)',
			'Clean rounding options: up, down, or to nearest unit',
			'Multi-language support in 10 languages',
			'Fast offline PWA functionality',
			'Light and dark mode theme',
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: faqItems.map((item) => ({
			'@type': 'Question',
			name: item.question,
			acceptedAnswer: { '@type': 'Answer', text: item.answer },
		})),
	},
	{
		'@context': 'https://schema.org',
		'@type': 'HowTo',
		name: 'How to Calculate Tip and Split a Bill With Tax',
		description: 'Step-by-step instructions to calculate exact tip amounts, include sales tax, and split the bill fairly among friends.',
		step: [
			{
				'@type': 'HowToStep',
				name: 'Enter your bill and sales tax',
				text: 'Enter the subtotal from your restaurant receipt and your local sales tax percentage.',
			},
			{
				'@type': 'HowToStep',
				name: 'Choose your desired tip percentage',
				text: 'Select a standard tip preset such as 15%, 18%, or 20%, or enter a custom percentage.',
			},
			{
				'@type': 'HowToStep',
				name: 'Set the group size and rounding',
				text: 'Enter the number of diners paying and optionally select round up or nearest to eliminate coins.',
			},
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: 'Tip Calculator With Tax',
		url: 'https://tipcalculatorwithtax.com/',
	},
];
---

<Layout
	title="Tip Calculator With Tax — Free Bill Splitter & Tip Guide"
	description="Fast, free tip calculator with tax support and bill splitting. Calculate tips in 40+ currencies, split among friends, round per person, and view international tipping guides."
	path="/"
	jsonLd={jsonLd}
>
	<Header />

	<main id="main">
		<!-- ======================================================== -->
		<!-- Wise Hero Band: Split Layout (DESIGN.md lines 324-328)  -->
		<!-- Headline Left, Currency-converter Card Right             -->
		<!-- ======================================================== -->
		<section class="hero-band hero">
			<div class="container hero__inner">
				<!-- Hero Left Column: Heavy 900 Display Voice -->
				<div class="hero__content">
					<div class="hero__badge badge-positive">
						<span class="hero__badge-dot" aria-hidden="true"></span>
						<span data-i18n="heroBadge">Free • Fast • 40+ Currencies • Bill Splitter</span>
					</div>

					<h1 class="hero__title display-xl" data-i18n="heroTitle">
						Tip Calculator With Tax
					</h1>

					<p class="hero__subtitle body-lg" data-i18n="heroSubtitle">
						Calculate tips, include sales tax, split the bill evenly, and round per-person totals accurately in any currency.
					</p>

					<!-- Trust Pills -->
					<div class="hero__props">
						<div class="hero__prop">
							<svg width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
								<circle cx="10" cy="10" r="9" fill="#9fe870" />
								<path d="m6 10 2.5 2.5 5.5-5.5" stroke="#0e0f0c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
							</svg>
							<span>40+ World Currencies</span>
						</div>
						<div class="hero__prop">
							<svg width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
								<circle cx="10" cy="10" r="9" fill="#9fe870" />
								<path d="m6 10 2.5 2.5 5.5-5.5" stroke="#0e0f0c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
							</svg>
							<span>100% Private & In-Browser</span>
						</div>
						<div class="hero__prop">
							<svg width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
								<circle cx="10" cy="10" r="9" fill="#9fe870" />
								<path d="m6 10 2.5 2.5 5.5-5.5" stroke="#0e0f0c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
							</svg>
							<span>Offline Ready Anywhere</span>
						</div>
					</div>

					<!-- In-page Navigation Pills -->
					<div class="hero__nav-pills">
						<a class="hero__pill-link" href="#how-it-works" data-i18n="navHowItWorks">How it works</a>
						<a class="hero__pill-link" href="#tip-guide" data-i18n="navTipGuide">Tip guide</a>
						<a class="hero__pill-link" href="#faq" data-i18n="navFaq">FAQ</a>
						<a class="hero__pill-link" href="/about/" data-i18n="footerAbout">About us</a>
					</div>
				</div>

				<!-- Hero Right Column: Signature Converter Card (DESIGN.md) -->
				<div class="hero__widget">
					<TipCalculator />
				</div>
			</div>
		</section>

		<!-- ======================================================== -->
		<!-- Content Band 1: How It Works (White Canvas Band)         -->
		<!-- ======================================================== -->
		<section class="content-band" id="how-it-works">
			<div class="container">
				<div class="section-header">
					<p class="eyebrow" data-i18n="howItWorksEyebrow">How it works</p>
					<h2 class="section-title display-md" data-i18n="howItWorksTitle">Three steps, instant answers</h2>
					<p class="section-lead" data-i18n="howItWorksLead">
						No complex mental math or awkward table calculations. The calculator updates instantly as you adjust any field.
					</p>
				</div>
				<ol class="steps">
					{
						steps.map((step) => (
							<li class="step card-feature-sage">
								<span class="step__number" aria-hidden="true">{step.number}</span>
								<h3 class="step__title" data-i18n={step.titleKey}>{step.title}</h3>
								<p class="step__text" data-i18n={step.descKey}>{step.desc}</p>
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<!-- ======================================================== -->
		<!-- Content Band 2: Features Grid (Sage Canvas Band)         -->
		<!-- ======================================================== -->
		<section class="section section--muted" id="features">
			<div class="container">
				<div class="section-header">
					<p class="eyebrow" data-i18n="featuresEyebrow">Built for every table</p>
					<h2 class="section-title display-md" data-i18n="featuresTitle">Everything you need, nothing you don’t</h2>
					<p class="section-lead" data-i18n="featuresLead">
						Designed to be lightning fast, 100% private, accessible offline, and easy to use anywhere in the world.
					</p>
				</div>
				<div class="features">
					{
						features.map((feature) => (
							<article class="feature card-content">
								<span class="feature__icon" aria-hidden="true">
									{feature.icon === 'globe' && (
										<svg width="22" height="22" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
											<circle cx="10" cy="10" r="7.25" stroke="currentColor" stroke-width="1.6" />
											<path d="M2.9 10h14.2M10 2.75c2 2.2 3 4.6 3 7.25s-1 5.05-3 7.25c-2-2.2-3-4.6-3-7.25s1-5.05 3-7.25Z" stroke="currentColor" stroke-width="1.6" />
										</svg>
									)}
									{feature.icon === 'percent' && (
										<svg width="22" height="22" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
											<path d="M15.5 4.5 4.5 15.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
											<circle cx="6.25" cy="6.25" r="2.5" stroke="currentColor" stroke-width="1.6" />
											<circle cx="13.75" cy="13.75" r="2.5" stroke="currentColor" stroke-width="1.6" />
										</svg>
									)}
									{feature.icon === 'users' && (
										<svg width="22" height="22" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
											<circle cx="7.25" cy="6.25" r="2.75" stroke="currentColor" stroke-width="1.6" />
											<path d="M2.5 16c0-2.6 2.13-4.5 4.75-4.5S12 13.4 12 16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
											<path d="M13.5 4.1a2.75 2.75 0 0 1 0 4.3M15 11.9c1.6.6 2.5 2 2.5 4.1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
										</svg>
									)}
									{feature.icon === 'check' && (
										<svg width="22" height="22" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
											<circle cx="10" cy="10" r="7.5" stroke="currentColor" stroke-width="1.6" />
											<path d="m6.5 10 2.5 2.5 4.5-4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
										</svg>
									)}
									{feature.icon === 'moon' && (
										<svg width="22" height="22" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
											<path d="M16.5 11.6A7 7 0 0 1 8.4 3.5a7 7 0 1 0 8.1 8.1Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
										</svg>
									)}
									{feature.icon === 'shield' && (
										<svg width="22" height="22" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
											<path d="M10 2.5 16 5v4.75c0 3.4-2.4 6.3-6 7.75-3.6-1.45-6-4.35-6-7.75V5l6-2.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
											<path d="m7.4 10 1.85 1.85L12.8 8.3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
										</svg>
									)}
								</span>
								<h3 class="feature__title" data-i18n={feature.titleKey}>{feature.title}</h3>
								<p class="feature__text" data-i18n={feature.descKey}>{feature.desc}</p>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<!-- ======================================================== -->
		<!-- Content Band 3: Tip Guide Section (White Canvas Band)    -->
		<!-- ======================================================== -->
		<section class="content-band" id="tip-guide">
			<div class="container">
				<div class="section-header">
					<p class="eyebrow" data-i18n="guideEyebrow">Tip guide</p>
					<h2 class="section-title display-md" data-i18n="guideTitle">What to tip by service & destination</h2>
					<p class="section-lead" data-i18n="guideLead">
						Tipping norms vary widely by service type and country. Use these benchmarks to tip with confidence.
					</p>
				</div>

				<div class="guide-grid">
					<!-- US Benchmarks Table -->
					<div class="guide-block card-feature-sage">
						<h3 class="guide-block__title" data-i18n="guideUsServicesTitle">United States Service Benchmarks</h3>
						<div class="table-wrap">
							<table class="guide-table">
								<thead>
									<tr>
										<th data-i18n="guideServiceCol">Service</th>
										<th data-i18n="guideStandardCol">Typical Tip</th>
									</tr>
								</thead>
								<tbody>
									{
										usTipGuide.map((row) => (
											<tr>
												<td data-i18n={row.serviceKey}>{row.service}</td>
												<td><span class="tip-pill">{row.tip}</span></td>
											</tr>
										))
									}
								</tbody>
							</table>
						</div>
					</div>

					<!-- International Etiquette Cards -->
					<div class="guide-block card-feature-sage">
						<h3 class="guide-block__title" data-i18n="guideInternationalTitle">International Tipping Norms</h3>
						<div class="intl-list">
							{
								internationalGuide.map((item) => (
									<div class="intl-card">
										<div class="intl-card__head">
											<span class="intl-card__region" data-i18n={item.regionKey}>{item.region}</span>
											<span class="intl-card__norm" data-i18n={item.normKey}>{item.norm}</span>
										</div>
										<p class="intl-card__details" data-i18n={item.detailsKey}>{item.details}</p>
									</div>
								))
							}
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ======================================================== -->
		<!-- Content Band 4: FAQ Section (Sage Canvas Band)           -->
		<!-- ======================================================== -->
		<section class="section section--muted" id="faq">
			<div class="container">
				<div class="section-header">
					<p class="eyebrow" data-i18n="faqEyebrow">FAQ</p>
					<h2 class="section-title display-md" data-i18n="faqTitle">Frequently Asked Questions</h2>
				</div>
				<div class="faq-wrap">
					<Faq items={faqItems} />
				</div>
			</div>
		</section>

		<!-- ======================================================== -->
		<!-- Content Band 5: Polarity-Flipped Dark CTA Card           -->
		<!-- (DESIGN.md: card-feature-dark with Wise Green headline)  -->
		<!-- ======================================================== -->
		<section class="cta-section">
			<div class="container">
				<div class="card-feature-dark cta-card">
					<div class="cta-card__content">
						<h2 class="cta-card__title display-sm" data-i18n="ctaTitle">
							The bill is ready. You know the exact number.
						</h2>
						<p class="cta-card__text" data-i18n="ctaText">
							Bookmark this tool on your phone for quick, accurate calculations at every meal and trip.
						</p>
					</div>
					<div class="cta-card__action">
						<a class="btn btn-primary" href="#calculator" data-i18n="ctaButton">
							Calculate My Tip
						</a>
					</div>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<style>
	/* ======================================================== */
	/* Wise Hero Split Layout (DESIGN.md lines 324-328)         */
	/* ======================================================== */
	.hero {
		padding-top: clamp(32px, 5vw, 56px);
		padding-bottom: clamp(48px, 6vw, 72px);
	}

	.hero__inner {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
		align-items: center;
		gap: clamp(32px, 5vw, 64px);
	}

	.hero__content {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--spacing-md);
	}

	.hero__badge {
		margin-bottom: var(--spacing-xs);
	}

	.hero__badge-dot {
