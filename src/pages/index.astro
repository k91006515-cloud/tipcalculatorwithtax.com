---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TipCalculator from '../components/TipCalculator.astro';
import Faq from '../components/Faq.astro';

const steps = [
	{
		number: '01',
		title: 'Enter the bill',
		text: 'Type the total from your receipt — or tap a quick amount to get started in one tap.',
	},
	{
		number: '02',
		title: 'Pick a tip',
		text: 'Choose a preset percentage like 15%, 18% or 20%, or type any custom amount you like.',
	},
	{
		number: '03',
		title: 'Split and share',
		text: 'Set how many people are paying and read off the exact amount each person owes.',
	},
];

const features = [
	{
		title: '40+ currencies',
		text: 'Switch between USD, EUR, GBP, JPY, INR and dozens more. Every amount is formatted the way your currency expects.',
		icon: 'globe',
	},
	{
		title: 'Any tip you like',
		text: 'Preset shortcuts for 10% through 50%, plus a custom field for the awkward "split the difference" moments.',
		icon: 'percent',
	},
	{
		title: 'Split any way',
		text: 'From two people at lunch to twenty on a rooftop, the per-person total updates as you type.',
		icon: 'users',
	},
	{
		title: 'Light & dark',
		text: 'A dark mode that follows your system preference, with a one-click toggle when you want to switch.',
		icon: 'moon',
	},
	{
		title: 'Private by design',
		text: 'Everything runs in your browser. No accounts, no receipts uploaded, nothing sent anywhere.',
		icon: 'shield',
	},
];

const tipGuide = [
	{ service: 'Sit-down restaurant', tip: '18 – 20%' },
	{ service: 'Cocktail bar', tip: '10%' },
	{ service: 'Coffee shop / counter', tip: '10%' },
	{ service: 'Room service', tip: '15%' },
	{ service: 'Taxi or rideshare', tip: '10 – 15%' },
	{ service: 'Hair salon or barber', tip: '10 – 15%' },
	{ service: 'Hotel housekeeping', tip: '5 – 10%' },
	{ service: 'Takeout / delivery', tip: '0 – 10%' },
	{ service: 'Car wash', tip: '10%' },
	{ service: 'Dog walker', tip: '15%' },
];

const faqItems = [
	{
		question: 'How much should I tip?',
		answer:
			'For sit-down service in the US, 18 – 20% is the standard. 15% is the traditional minimum, 25% or more is generous, and anywhere in between is perfectly acceptable. Check the tip guide above for suggestions by service type.',
	},
	{
		question: 'How is the per-person amount calculated?',
		answer:
			'We take your bill, add the tip (bill × tip percentage), then divide that total by the number of people. If you turn on rounding, the per-person figure is adjusted to a whole unit of your currency — everything else stays exact.',
	},
	{
		question: 'Can I split the bill unevenly?',
		answer:
			'This calculator splits the total evenly, which is what most groups need. If someone paid for more than their share, take the total and subtract their items manually, or use the copy button to bring the per-person figure into your own app.',
	},
	{
		question: 'Does the calculator work offline?',
		answer:
			'Once the page has loaded, yes. All calculations run locally in your browser, so it keeps working on a spotty connection or in aeroplane mode.',
	},
	{
		question: 'Which currencies are supported?',
		answer:
			'Over 40 currencies including USD, EUR, GBP, JPY, CNY, INR, CAD, AUD, CHF, BRL, MXN, AED and ZAR. Amounts are rounded and formatted using the minor units of each currency, so zero-decimal currencies like the Japanese yen are handled correctly.',
	},
	{
		question: 'Is my data stored?',
		answer:
			'No. Your bill amount never leaves the device. We only remember your currency choice, rounding preference and theme locally in your browser so they are still there next time.',
	},
	{
		question: 'How much to tip waitress calculator',
		answer:
			'Use the tip calculator to enter your bill amount and select a percentage — 15–20% is standard for waitress service in the US. The calculator will show the tip amount and total per person.',
	},
	{
		question: 'is there a ruler online?',
		answer:
			'Yes, there are many online ruler tools that use your screen size to display actual measurements. You can find one by searching "online ruler" and adjusting for your device\'s screen dimensions.',
	},
	{
		question: 'how to calculate tip on calculator',
		answer:
			'Multiply the bill total by the tip percentage (e.g., 18% = 0.18). The calculator does this automatically — just enter the bill amount and select or enter your desired tip percentage.',
	},
	{
		question: 'how to measure cm online?',
		answer:
			'Online rulers display centimeters based on your screen resolution. For best results, calibrate using a known object like a credit card (approximately 8.5 cm wide).',
	},
	{
		question: 'tip calculator how much to tip',
		answer:
			'The amount depends on service quality and culture. In the US, 15% is minimum, 18–20% is standard for good service, and 25%+ is generous. For food delivery, 10–15% is typical.',
	},
	{
		question: 'can I use my camera as a ruler?',
		answer:
			'Yes, there are camera ruler apps that use phone sensors or on-screen references to measure objects. Some use a known object for scale, others use AR technology.',
	},
	{
		question: 'How do you calculate a tip?',
		answer:
			'Tip = Bill total × Tip percentage. For example, on a $50 bill with 18% tip: $50 × 0.18 = $9 tip. The calculator computes this instantly.',
	},
	{
		question: 'Should you calculate tip before or after tax?',
		answer:
			'This is personal preference. Some calculate tip on the pre-tax amount, others on the total including tax. Restaurants typically expect tipping on the total amount paid.',
	},
	{
		question: 'How much should you tip at a restaurant?',
		answer:
			'15% is the traditional minimum, 18–20% is standard for good service, and 25%+ is generous. For poor service, 10% is acceptable. Check the tip guide for service-specific norms.',
	},
	{
		question: 'How do you calculate tip with tax?',
		answer:
			'Either multiply the pre-tax total by the tip percentage, then add tax; or multiply the total (bill + tax) by the tip percentage. Both methods are commonly used.',
	},
	{
		question: 'How do you split a bill with tax and tip?',
		answer:
			'Add the bill total, tax, and tip amount together, then divide by the number of people. The calculator handles this: enter the bill, tax rate, tip percentage, and split count.',
	},
	{
		question: 'What is a 15%, 18%, 20%, or 25% tip?',
		answer:
			'These are common tip percentages: 15% is the traditional minimum, 18% is for satisfactory service, 20% is standard for good service, and 25% is generous or for exceptional service.',
	},
	{
		question: 'How do you calculate tip per person?',
		answer:
			'(Bill + Tip) ÷ Number of people. The calculator adds the tip to the bill total, then divides by the count of people. Rounding can adjust the per-person amount to a whole unit.',
	},
	{
		question: 'How do you round up or down a tip?',
		answer:
			'Round to the nearest whole dollar or desired unit. Some people round up for simplicity (e.g., $9.40 tip → $10). Others round down or keep the exact calculated amount.',
	},
	{
		question: 'Is there a free tip calculator app for Android',
		answer:
			'Yes, there are many free tip calculator apps available on the Google Play Store. Search "tip calculator" for options with bill splitting, tax support, and rounding features.',
	},
	{
		question: 'Is there a simple tip calculator free online',
		answer:
			'Yes, this website is a free online tip calculator — no download needed. Enter your bill, choose a percentage, and get instant results including tip amount, total, and per-person split.',
	},
	{
		question: 'Does Google have a tip calculator',
		answer:
			'Google has a built-in tip calculator — search "tip calculator" or "calculate tip" in Google, enter your bill amount and tip percentage, and Google will compute the result instantly.',
	},
];

const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebApplication',
		name: 'Tip Calculator With Tax',
		url: 'https://tipcalculatorwithtax.com/',
		applicationCategory: 'FinanceApplication',
		operatingSystem: 'Any',
		description:
			'Free online tip calculator with a currency selector, custom tip percentages, bill splitting, rounding options and a light/dark mode toggle.',
		offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
		featureList: [
			'Tip percentage presets and custom tips',
			'Split the bill between any number of people',
			'40+ currencies with correct formatting',
			'Rounding up, down or to the nearest amount',
			'Light and dark mode',
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: faqItems.map((item) => ({
			'@type': 'Question',
			name: item.question,
			acceptedAnswer: { '@type': 'Answer', text: item.answer },
		})),
	},
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: 'Tip Calculator With Tax',
		url: 'https://tipcalculatorwithtax.com/',
	},
];
---

<Layout
	title="Tip Calculator — Free Tip & Bill Splitter with Tax Support"
	description="Free tip calculator with tax support, split bill functionality, 40+ currencies, rounding options and dark mode. Calculate 15%, 18%, 20%, 25% tips instantly."
	path="/"
	jsonLd={jsonLd}
>
	<Header />

	<main id="main">
		<section class="hero" style="background: var(--canvas);">
			<div class="container hero__inner" style="padding: clamp(40px, 8vw, 60px) clamp(60px, 10vw, 80px); border-radius: var(--r-lg);">
				<h1 class="hero__title">Tip Calculator <span class="hero__gold">With Tax</span></h1>
				<p class="hero__lead">
					Calculate tips, split bills, and include tax — easily and accurately.
				</p>
			</div>
		</section>

		<div class="container calculator-wrap" style="margin-top: clamp(30px, 8vw, 60px)">
			<TipCalculator />

			<div class="links-below">
				<div class="links-below__row">
					<a class="link-below" href="/about/">About us</a>
					<a class="link-below" href="/contact/">Contact us</a>
					<a class="link-below" href="#how-it-works">How it works</a>
					<a class="link-below" href="#faq">FAQ</a>
				</div>
			</div>
		</div>

		<section class="section" id="how-it-works">
			<div class="container">
				<p class="eyebrow">How it works</p>
				<h2 class="section-title">Three steps, one number</h2>
				<p class="section-lead">
					No hoops, no formulas to remember. The calculator updates the moment you change anything.
				</p>
				<ol class="steps">
					{
						steps.map((step) => (
							<li class="step card">
								<span class="step__number">{step.number}</span>
								<h3 class="step__title">{step.title}</h3>
								<p class="step__text">{step.text}</p>
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<section class="section section--muted" id="features">
			<div class="container">
				<p class="eyebrow">Built for real tables</p>
				<h2 class="section-title">Everything you need, nothing you don't</h2>
				<p class="section-lead">
					A tip calculator that stays out of the way, works offline, and respects your privacy.
				</p>
				<div class="features">
					{
						features.map((feature) => (
							<article class="feature card">
								<span class="feature__icon" aria-hidden="true">
									{feature.icon === 'globe' && (
										<svg width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
											<circle cx="10" cy="10" r="7.25" stroke="currentColor" stroke-width="1.4" />
											<path d="M2.9 10h14.2M10 2.75c2 2.2 3 4.6 3 7.25s-1 5.05-3 7.25c-2-2.2-3-4.6-3-7.25s1-5.05 3-7.25Z" stroke="currentColor" stroke-width="1.4" />
										</svg>
									)}
									{feature.icon === 'percent' && (
										<svg width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
											<path d="M15.5 4.5 4.5 15.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
											<circle cx="6.25" cy="6.25" r="2.5" stroke="currentColor" stroke-width="1.4" />
											<circle cx="13.75" cy="13.75" r="2.5" stroke="currentColor" stroke-width="1.4" />
										</svg>
									)}
									{feature.icon === 'users' && (
										<svg width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
											<circle cx="7.25" cy="6.25" r="2.75" stroke="currentColor" stroke-width="1.4" />
											<path d="M2.5 16c0-2.6 2.13-4.5 4.75-4.5S12 13.4 12 16" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
											<path d="M13.5 4.1a2.75 2.75 0 0 1 0 4.3M15 11.9c1.6.6 2.5 2 2.5 4.1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
										</svg>
									)}
									{feature.icon === 'ruler' && (
										<svg width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
											<rect x="2.25" y="6.25" width="15.5" height="7.5" rx="1.75" stroke="currentColor" stroke-width="1.4" />
											<path d="M6 6.25v3M9 6.25v4.5M12 6.25v3M15 6.25v4.5" stroke="currentColor" stroke-width="1.4" />
										</svg>
									)}
									{feature.icon === 'moon' && (
										<svg width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
											<path d="M16.5 11.6A7 7 0 0 1 8.4 3.5a7 7 0 1 0 8.1 8.1Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
										</svg>
									)}
									{feature.icon === 'shield' && (
										<svg width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
											<path d="M10 2.5 16 5v4.75c0 3.4-2.4 6.3-6 7.75-3.6-1.45-6-4.35-6-7.75V5l6-2.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
											<path d="m7.4 10 1.85 1.85L12.8 8.3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
										</svg>
									)}
								</span>
								<h3 class="feature__title">{feature.title}</h3>
								<p class="feature__text">{feature.text}</p>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<section class="section" id="tip-guide">
			<div class="container guide">
				<div class="guide__intro">
					<p class="eyebrow">Tip guide</p>
					<h2 class="section-title">What to tip, by service</h2>
					<p class="section-lead">
						Not sure where to start? These are the tipping norms most people follow in the United States. Elsewhere, a round 10% usually works.
					</p>
				</div>
				<ul class="guide__list card">
					{
						tipGuide.map((row) => (
							<li class="guide__row">
								<span class="guide__service">{row.service}</span>
								<span class="guide__tip">{row.tip}</span>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<section class="section section--muted" id="faq">
			<div class="container">
				<p class="eyebrow">FAQ</p>
				<h2 class="section-title">Questions, answered</h2>
				<div class="faq-wrap">
					<Faq items={faqItems} />
				</div>
			</div>
		</section>

		<section class="cta">
			<div class="container cta__inner">
				<div>
					<h2 class="cta__title">The bill is ready. You know the number.</h2>
					<p class="cta__text">
						Open the calculator, drop in the total, and go back to your table.
					</p>
				</div>
				<a class="btn btn-primary btn-pill" href="#calculator">Calculate my tip</a>
			</div>
		</section>
	</main>

	<Footer />
</Layout>