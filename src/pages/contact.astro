---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
	title="Contact Us — Tip Calculator With Tax"
	description="Get in touch with us about Tip Calculator With Tax."
	path="/contact/"
>
	<Header />

	<main id="main" class="page">
		<div class="container page__inner">
			<p class="eyebrow">Contact</p>
			<h1 class="page__title">Contact Us</h1>
			<p class="page__meta">Last updated: 20 October 2026</p>

			<div class="prose">
				<h2>Email Us</h2>
				<p>
					Send us a message at <a href="mailto:hello@tipcalculatorwithtax.com">hello@tipcalculatorwithtax.com</a>.
				</p>

				<h2>We're Here to Help</h2>
				<p>
					Whether you have feedback, feature requests, or just want to say hello, we'd love
					to hear from you. Our team typically responds within 2‑3 business days.
				</p>

				<h2>Follow Us</h2>
				<p>
					We don't have social media accounts, but you can always reach us by email.
				</p>
			</div>
		</div>
	</main>

	<Footer />
</Layout>