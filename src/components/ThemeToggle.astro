<button
	class="theme-toggle"
	type="button"
	data-theme-toggle
	aria-pressed="false"
	aria-label="Dark mode"
	title="Dark mode"
>
	<svg
		class="theme-toggle__sun"
		aria-hidden="true"
		width="16"
		height="16"
		viewBox="0 0 16 16"
		fill="none"
		xmlns="http://www.w3.org/2000/svg"
	>
		<circle cx="8" cy="8" r="3.25" stroke="currentColor" stroke-width="1.3"></circle>
		<path
			d="M8 1v1.6M8 13.4V15M15 8h-1.6M2.6 8H1M12.95 3.05l-1.13 1.13M4.18 11.82l-1.13 1.13M12.95 12.95l-1.13-1.13M4.18 4.18 3.05 3.05"
			stroke="currentColor"
			stroke-width="1.3"
			stroke-linecap="round"></path>
	</svg>
	<svg
		class="theme-toggle__moon"
		aria-hidden="true"
		width="16"
		height="16"
		viewBox="0 0 16 16"
		fill="none"
		xmlns="http://www.w3.org/2000/svg"
	>
		<path
			d="M13.5 9.6A5.8 5.8 0 0 1 6.4 2.5a5.8 5.8 0 1 0 7.1 7.1Z"
			stroke="currentColor"
			stroke-width="1.3"
			stroke-linejoin="round"></path>
	</svg>
</button>

<style>
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		padding: 0;
		border: 1px solid var(--hairline);
		border-radius: var(--r-sm);
		background: var(--surface);
		color: var(--ink);
		cursor: pointer;
		transition:
			border-color 0.15s ease,
			background-color 0.15s ease;
	}

	.theme-toggle:hover {
		border-color: var(--hairline-strong);
		background: var(--surface-2);
	}

	/* The icon shows the mode you would switch *to*. */
	.theme-toggle__sun {
		display: none;
	}

	:global([data-theme='dark']) .theme-toggle__sun {
		display: block;
	}

	:global([data-theme='dark']) .theme-toggle__moon {
		display: none;
	}
</style>
