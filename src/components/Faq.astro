---
export interface FaqItem {
	question: string;
	answer: string;
	qKey?: string;
	aKey?: string;
}

interface Props {
	items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="faq" role="region" aria-label="Frequently Asked Questions">
	{
		items.map((item, idx) => (
			<details class="faq__item" open={idx === 0}>
				<summary class="faq__question">
					<span data-i18n={item.qKey}>{item.question}</span>
					<span class="faq__icon" aria-hidden="true">
						<svg
							width="16"
							height="16"
							viewBox="0 0 16 16"
							fill="none"
							xmlns="http://www.w3.org/2000/svg"
						>
							<path
								d="M8 3v10M3 8h10"
								stroke="currentColor"
								stroke-width="1.6"
								stroke-linecap="round"
							/>
						</svg>
					</span>
				</summary>
				<div class="faq__answer-wrap">
					<p class="faq__answer" data-i18n={item.aKey}>{item.answer}</p>
				</div>
			</details>
		))
	}
</div>

<style>
	.faq {
		display: flex;
		flex-direction: column;
		border-top: 1px solid var(--hairline);
	}

	.faq__item {
		border-bottom: 1px solid var(--hairline);
		transition: background-color 0.15s ease;
	}

	.faq__item[open] {
		background: color-mix(in srgb, var(--surface) 60%, transparent);
	}

	.faq__question {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--s-lg);
		padding: var(--s-md) 4px;
		color: var(--ink);
		font-size: 16px;
		font-weight: 600;
		line-height: 24px;
		cursor: pointer;
		list-style: none;
		user-select: none;
	}

	.faq__question::-webkit-details-marker {
		display: none;
	}

	.faq__question:hover {
		color: var(--accent);
	}

	.faq__icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		border-radius: var(--r-full);
		background: var(--surface-2);
		color: var(--mute);
		flex-shrink: 0;
		transition: transform 0.2s ease, background-color 0.2s ease, color 0.2s ease;
	}

	.faq__question:hover .faq__icon {
		color: var(--ink);
		background: var(--surface-3);
	}

	.faq__item[open] .faq__icon {
		transform: rotate(45deg);
		background: color-mix(in srgb, var(--accent) 15%, transparent);
		color: var(--accent);
	}

	.faq__answer-wrap {
		padding: 0 4px var(--s-lg);
	}

	.faq__answer {
		margin: 0;
		max-width: 760px;
		color: var(--body);
		font-size: 15px;
		line-height: 26px;
	}
</style>
