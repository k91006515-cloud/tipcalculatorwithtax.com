---
export interface FaqItem {
	question: string;
	answer: string;
	qKey?: string;
	aKey?: string;
}

interface Props {
	items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="faq" role="region" aria-label="Frequently Asked Questions">
	{
		items.map((item, idx) => (
			<details class="faq__item" open={idx === 0}>
				<summary class="faq__question">
					<span class="faq__question-text" data-i18n={item.qKey}>{item.question}</span>
					<span class="faq__icon" aria-hidden="true">
						<svg
							width="16"
							height="16"
							viewBox="0 0 16 16"
							fill="none"
							xmlns="http://www.w3.org/2000/svg"
						>
							<path
								d="M8 3v10M3 8h10"
								stroke="currentColor"
								stroke-width="1.8"
								stroke-linecap="round"
							/>
						</svg>
					</span>
				</summary>
				<div class="faq__answer-wrap">
					<p class="faq__answer" data-i18n={item.aKey}>{item.answer}</p>
				</div>
			</details>
		))
	}
</div>

<style>
	.faq {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.faq__item {
		border-radius: var(--rounded-xl); /* 24px canonical */
		background-color: var(--color-canvas);
		border: 1px solid var(--color-hairline);
		overflow: hidden;
		transition: border-color 0.15s ease, box-shadow 0.15s ease;
	}

	.faq__item:hover {
		border-color: var(--color-hairline-strong);
	}

	.faq__item[open] {
		box-shadow: var(--shadow-card);
		border-color: var(--color-hairline);
	}

	.faq__question {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-lg);
		padding: 20px 24px;
		color: var(--color-ink);
		font-family: var(--font-sans);
		font-size: 16px;
		font-weight: 600;
		line-height: 24px;
		cursor: pointer;
		list-style: none;
		user-select: none;
	}

	.faq__question::-webkit-details-marker {
		display: none;
	}

	.faq__question-text {
		color: var(--color-ink);
	}

	.faq__icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		border-radius: var(--rounded-full);
		background-color: var(--color-canvas-soft);
		color: var(--color-ink);
		flex-shrink: 0;
		transition: transform 0.2s ease, background-color 0.2s ease, color 0.2s ease;
	}

	.faq__item:hover .faq__icon {
		background-color: var(--surface-3);
	}

	.faq__item[open] .faq__icon {
		transform: rotate(45deg);
		background-color: var(--color-primary);
		color: var(--color-on-primary);
	}

	.faq__answer-wrap {
		padding: 0 24px 22px;
	}

	.faq__answer {
		margin: 0;
		max-width: 760px;
		color: var(--color-body);
		font-family: var(--font-sans);
		font-size: 15px;
		line-height: 25px;
	}
</style>
