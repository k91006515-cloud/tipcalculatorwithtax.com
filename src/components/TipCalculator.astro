---
import { CURRENCIES, POPULAR_CURRENCY_CODES, CURRENCY_REGIONS } from '../data/currencies';

const tipPresets = [0, 10, 15, 18, 20, 25, 30, 50];
const roundingOptions = [
	{ value: 'off', labelKey: 'roundOff', labelFallback: 'Off' },
	{ value: 'up', labelKey: 'roundUp', labelFallback: 'Up' },
	{ value: 'down', labelKey: 'roundDown', labelFallback: 'Down' },
	{ value: 'nearest', labelKey: 'roundNearest', labelFallback: 'Nearest' },
];
const quickAmounts = [20, 50, 100, 200];
const popularCurrencies = CURRENCIES.filter((c) => POPULAR_CURRENCY_CODES.includes(c.code));
---

<section class="calc currency-converter-card" id="calculator" data-stc-calculator aria-labelledby="calc-heading">
	<h2 class="sr-only" id="calc-heading" data-i18n="calcHeading">Tip Calculator</h2>

	<noscript>
		<p class="calc__noscript">
			This calculator runs client-side with JavaScript. Tip = bill × percentage, total = bill + tax + tip, split per person = total ÷ people.
		</p>
	</noscript>

	<div class="calc__grid">
		<!-- Left Input Panel -->
		<div class="calc__panel">
			<!-- Bill Amount Field -->
			<div class="field">
				<div class="field__header">
					<label class="field__label" for="bill-amount" data-i18n="billAmount">Bill amount</label>
					<div class="quick">
						<span class="field__hint" data-i18n="quickAmounts">Quick:</span>
						{
							quickAmounts.map((amount) => (
								<button
									type="button"
									class="quick__btn"
									data-quick-amount={amount}
									title={`Set bill to ${amount}`}
								>
									${amount}
								</button>
							))
						}
					</div>
				</div>
				<div class="amount">
					<div class="amount__currency" title="Click to change currency">
						<span class="amount__currency-symbol" data-out="currency-symbol">$</span>
						<select
							class="amount__currency-select"
							data-stc-currency
							aria-label="Select currency"
						>
							<optgroup label="Popular">
								{
									popularCurrencies.map((c) => (
										<option value={c.code}>
											{c.code} ({c.symbol})
										</option>
									))
								}
							</optgroup>
							{
								CURRENCY_REGIONS.map((region) => (
									<optgroup label={region}>
										{CURRENCIES.filter((c) => c.region === region).map((c) => (
											<option value={c.code}>
												{c.code} – {c.name} ({c.symbol})
											</option>
										))}
									</optgroup>
								))
							}
						</select>
						<svg
							class="amount__currency-chevron"
							width="10"
							height="10"
							viewBox="0 0 12 12"
							fill="none"
							xmlns="http://www.w3.org/2000/svg"
							aria-hidden="true"
						>
							<path
								d="M2.5 4.5 6 8l3.5-3.5"
								stroke="currentColor"
								stroke-width="1.6"
								stroke-linecap="round"
								stroke-linejoin="round"></path>
						</svg>
					</div>
					<input
						class="amount__input"
						id="bill-amount"
						type="text"
						inputmode="decimal"
						autocomplete="off"
						spellcheck="false"
						placeholder="0.00"
						data-field="bill"
						aria-label="Bill amount"
					/>
				</div>
			</div>

			<!-- Tip Percentage Field -->
			<div class="field">
				<div class="field__header">
					<span class="field__label" id="tip-label" data-i18n="tipPercentage">Tip percentage</span>
					<div class="tip-custom">
						<label class="tip-custom__label" for="tip-percent" data-i18n="customTip">Custom:</label>
						<div class="tip-custom__control">
							<input
								id="tip-percent"
								type="number"
								inputmode="decimal"
								autocomplete="off"
								min="0"
								max="500"
								step="1"
								value="20"
								data-field="tip"
								aria-label="Custom tip percentage"
							/>
							<span class="tip-custom__suffix" aria-hidden="true">%</span>
						</div>
					</div>
				</div>
				<div class="presets" role="group" aria-labelledby="tip-label">
					{
						tipPresets.map((preset) => (
							<button
								type="button"
								class={`preset ${preset === 20 ? 'is-active' : ''}`}
								data-tip-preset={preset}
								aria-pressed={preset === 20 ? 'true' : 'false'}
							>
								{preset}%
							</button>
						))
					}
				</div>
			</div>

			<!-- Sales Tax Field -->
			<div class="field">
				<div class="field__header">
					<label class="field__label" for="tax-percent">
						<span data-i18n="taxRate">Tax rate</span>
						<span class="field__sublabel" data-i18n="taxHint">(Optional)</span>
					</label>
				</div>
				<div class="tax-row">
					<div class="tip-custom__control tax-control">
						<input
							id="tax-percent"
							type="number"
							inputmode="decimal"
							autocomplete="off"
							min="0"
							max="100"
							step="0.01"
							value="0"
							data-field="tax"
							aria-label="Sales tax percentage"
						/>
						<span class="tip-custom__suffix" aria-hidden="true">%</span>
					</div>
					<div class="tax-presets">
						<button type="button" class="tax-preset-btn" data-tax-preset="0">0%</button>
						<button type="button" class="tax-preset-btn" data-tax-preset="5">5%</button>
						<button type="button" class="tax-preset-btn" data-tax-preset="8.25">8.25%</button>
						<button type="button" class="tax-preset-btn" data-tax-preset="10">10%</button>
					</div>
				</div>
			</div>

			<!-- Number of People Field -->
			<div class="field">
				<label class="field__label" for="people-count" data-i18n="numberOfPeople">Number of people</label>
				<div class="stepper-wrap">
					<div class="stepper">
						<button
							type="button"
							data-action="people-dec"
							aria-label="One person fewer"
							data-i18n-aria="peopleFewerAria"
						>−</button>
						<input
							id="people-count"
							type="number"
							inputmode="numeric"
							min="1"
							max="999"
							step="1"
							value="1"
							data-field="people"
							aria-valuemin="1"
							aria-valuemax="999"
							aria-label="Number of people"
						/>
						<button
							type="button"
							data-action="people-inc"
							aria-label="One person more"
							data-i18n-aria="peopleMoreAria"
						>+</button>
					</div>
					<div class="people-presets">
						<button type="button" class="people-preset-btn" data-people-preset="1">1</button>
						<button type="button" class="people-preset-btn" data-people-preset="2">2</button>
						<button type="button" class="people-preset-btn" data-people-preset="4">4</button>
						<button type="button" class="people-preset-btn" data-people-preset="6">6</button>
					</div>
				</div>
			</div>

			<!-- Rounding Options Field -->
			<div class="field">
				<span class="field__label" id="rounding-label" data-i18n="roundingLabel">Round per-person total</span>
				<div class="segmented" role="radiogroup" aria-labelledby="rounding-label">
					{
						roundingOptions.map((option) => (
							<label class="segmented__option">
								<input
									type="radio"
									name="stc-rounding"
									value={option.value}
									checked={option.value === 'off'}
								/>
								<span data-i18n={option.labelKey}>{option.labelFallback}</span>
							</label>
						))
					}
				</div>
			</div>
		</div>

		<!-- Right Result Panel (card-feature-sage styling on sage hero) -->
		<div class="calc__result">
			<div class="result__card">
				<!-- Head Badge & Quick Copy -->
				<div class="result__head">
					<span class="badge-positive" data-out="person-badge">
						<svg width="14" height="14" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
							<path d="M10 10a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM3 18c0-3.3 3.1-6 7-6s7 2.7 7 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
						</svg>
						<span data-out="per-person-caption" data-i18n="totalToPay">Total to pay</span>
					</span>
					<button
						class="btn btn-secondary result__copy-mini"
						type="button"
						data-action="copy"
						title="Copy per-person amount"
						aria-label="Copy amount"
					>
						<svg width="14" height="14" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
							<rect x="5" y="5" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
							<path d="M3 11V3.5A1.5 1.5 0 0 1 4.5 2H11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
						</svg>
						<span data-out="copy-label" data-i18n="copyResult">Copy</span>
					</button>
				</div>

				<!-- Main Result Amount (Wise Heavy 900 Display) -->
				<div class="result__amount-wrap">
					<p class="result__amount" data-out="per-person" role="status" aria-live="polite">$0.00</p>
				</div>

				<!-- Visual Split Bar (Wise Green) -->
				<div class="result__split" data-out="split" hidden>
					<div class="split__bar" data-out="split-bar" aria-hidden="true"></div>
					<p class="split__legend" data-out="split-legend"></p>
				</div>

				<!-- Breakdown List -->
				<dl class="result__rows">
					<div class="result__row">
						<dt>
							<span class="result__dot result__dot--bill"></span>
							<span data-i18n="billAmount">Bill amount</span>
						</dt>
						<dd data-out="bill-display">$0.00</dd>
					</div>
					<div class="result__row">
						<dt>
							<span class="result__dot result__dot--tax"></span>
							<span data-i18n="taxLabel">Tax</span>
							<span class="result__row-pct" data-out="tax-pct">(0%)</span>
						</dt>
						<dd data-out="tax">$0.00</dd>
					</div>
					<div class="result__row">
						<dt>
							<span class="result__dot result__dot--tip"></span>
							<span data-i18n="tipLabel">Tip</span>
							<span class="result__row-pct" data-out="tip-pct">(20%)</span>
						</dt>
						<dd data-out="tip">$0.00</dd>
					</div>
					<div class="result__row result__row--highlight">
						<dt>
							<span class="result__dot result__dot--total"></span>
							<strong data-i18n="totalLabel">Total</strong>
						</dt>
						<dd><strong data-out="total">$0.00</strong></dd>
					</div>
					<div class="result__row result__row--sub" data-out="tip-per-person-row" hidden>
						<dt data-i18n="tipPerPersonLabel">Tip per person</dt>
						<dd data-out="tip-per-person">$0.00</dd>
					</div>
				</dl>

				<!-- Formula and Notes -->
				<p class="result__formula" data-out="formula"></p>
				<p class="result__note badge-positive" data-out="rounding-note" hidden></p>

				<!-- Action Buttons (Wise Lime Pill is Primary Action) -->
				<div class="result__actions">
					<button
						class="btn btn-primary result__action-btn"
						type="button"
						data-action="copy"
						title="Copy calculation summary"
					>
						<svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
							<rect x="5" y="5" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.6"/>
							<path d="M3 11V3.5A1.5 1.5 0 0 1 4.5 2H11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
						</svg>
						<span data-out="copy-label" data-i18n="copyResult">Copy Result</span>
					</button>

					<button
						class="btn btn-secondary result__action-btn"
						type="button"
						data-action="copy-link"
						title="Share this calculation as a direct link"
					>
						<svg width="15" height="15" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
							<path d="M6.5 9.5 9.5 6.5M6 6.5l-1.5 1.5a2.12 2.12 0 1 0 3 3L9 9.5M10 9.5l1.5-1.5a2.12 2.12 0 0 0-3-3L7 6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
						</svg>
						<span data-i18n="copyLink">Share</span>
					</button>

					<button
						class="btn btn-tertiary result__action-btn result__action-btn--reset"
						type="button"
						data-action="reset"
						title="Reset calculator to defaults"
					>
						<svg width="15" height="15" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
							<path d="M2.5 8a5.5 5.5 0 1 1 1.6 3.9L2 14M2 9.5V14h4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
						<span data-i18n="reset">Reset</span>
					</button>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	/* currency-converter-card (DESIGN.md) */
	.calc {
		width: 100%;
		background-color: var(--color-canvas);
		border-radius: var(--rounded-xl); /* Canonical 24px radius */
		border: 1px solid var(--color-hairline);
		box-shadow: var(--shadow-card);
		overflow: hidden;
	}

	.calc__noscript {
		margin: var(--spacing-md);
		padding: var(--spacing-md);
		border-radius: var(--rounded-md);
		background-color: var(--color-canvas-soft);
		color: var(--color-body);
		font-size: 14px;
		line-height: 22px;
	}

	.calc__grid {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
	}

	/* Left Panel */
	.calc__panel {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-lg);
		padding: clamp(20px, 2.5vw, 28px);
		background-color: var(--color-canvas);
		border-right: 1px solid var(--color-hairline);
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.field__header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-sm);
	}

	.field__label {
		color: var(--color-ink);
		font-family: var(--font-sans);
		font-size: 14px;
		font-weight: 600;
		line-height: 20px;
		display: flex;
		align-items: center;
		gap: 6px;
	}

	.field__hint {
		color: var(--color-mute);
		font-size: 12px;
		font-weight: 500;
	}

	.field__sublabel {
		color: var(--color-mute);
		font-size: 12px;
		font-weight: 400;
	}

	/* Amount Input (Wise Style: bold 900 display, clean pill geometry) */
	.amount {
		position: relative;
		display: flex;
		align-items: stretch;
		border: 1.5px solid var(--color-hairline);
		border-radius: var(--rounded-xl); /* 24px */
		background-color: var(--color-canvas);
		transition: border-color 0.15s ease;
	}

	.amount:focus-within {
		border-color: var(--color-ink);
	}

	.amount__currency {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 6px;
		flex: 0 0 auto;
		padding: 0 16px;
		border-right: 1.5px solid var(--color-hairline);
		background-color: var(--color-canvas-soft);
		border-top-left-radius: calc(var(--rounded-xl) - 1.5px);
		border-bottom-left-radius: calc(var(--rounded-xl) - 1.5px);
		color: var(--color-ink);
		font-family: var(--font-sans);
		font-size: 15px;
		font-weight: 700;
		cursor: pointer;
		user-select: none;
	}

	.amount__currency-symbol {
		font-weight: 700;
		color: var(--color-ink);
	}

	.amount__currency-chevron {
		color: var(--color-mute);
		pointer-events: none;
	}

	.amount__currency-select {
		position: absolute;
		inset: 0;
		opacity: 0;
		width: 100%;
		height: 100%;
		cursor: pointer;
	}

	.amount__input {
		flex: 1 1 auto;
		min-width: 0;
		padding: 12px 18px;
		border: 0;
		background: transparent;
		color: var(--color-ink);
		font-family: var(--font-display);
		font-size: clamp(24px, 3.2vw, 34px);
		font-weight: 900;
		line-height: 1.1;
		letter-spacing: -0.02em;
		font-variant-numeric: tabular-nums;
		outline: none;
	}

	.amount__input::placeholder {
		color: var(--color-mute);
		opacity: 0.5;
	}

	/* Quick Amounts */
	.quick {
		display: flex;
		align-items: center;
		gap: 6px;
	}

	.quick__btn {
		height: 28px;
		padding: 0 10px;
		border: 1px solid var(--color-hairline);
		border-radius: var(--rounded-pill);
		background-color: var(--color-canvas-soft);
		color: var(--color-ink);
		font-family: var(--font-sans);
		font-size: 13px;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		cursor: pointer;
		transition: background-color 0.15s ease, border-color 0.15s ease;
	}

	.quick__btn:hover {
		background-color: var(--color-primary-pale);
		border-color: var(--color-primary);
		color: var(--color-ink);
	}

	/* Tip Presets: Wise signature 24px pill buttons */
	.presets {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 8px;
	}

	.preset {
		height: 42px;
		border: 1.5px solid var(--color-hairline);
		border-radius: var(--rounded-xl); /* 24px */
		background-color: var(--color-canvas);
		color: var(--color-ink);
		font-family: var(--font-sans);
		font-size: 14.5px;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		cursor: pointer;
		transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
	}

	.preset:hover {
		border-color: var(--color-hairline-strong);
		background-color: var(--color-canvas-soft);
	}

	/* Active preset: Wise lime-green CTA signature */
	.preset.is-active {
		background-color: var(--color-primary);
		border-color: var(--color-primary);
		color: var(--color-on-primary);
		font-weight: 700;
	}

	/* Custom Tip and Tax Controls */
	.tip-custom {
		display: flex;
		align-items: center;
		gap: 6px;
	}

	.tip-custom__label {
		color: var(--color-mute);
		font-size: 13px;
		font-weight: 500;
	}

	.tip-custom__control {
		display: inline-flex;
		align-items: center;
		height: 36px;
		padding: 0 10px;
		border: 1.5px solid var(--color-hairline);
		border-radius: var(--rounded-md);
		background-color: var(--color-canvas);
		transition: border-color 0.15s ease;
	}

	.tip-custom__control:focus-within {
		border-color: var(--color-ink);
	}

	.tip-custom__control input {
		width: 48px;
		border: 0;
		background: transparent;
		color: var(--color-ink);
		font-family: var(--font-sans);
		font-size: 14px;
		font-weight: 700;
		font-variant-numeric: tabular-nums;
		outline: none;
	}

	.tip-custom__control input::-webkit-outer-spin-button,
	.tip-custom__control input::-webkit-inner-spin-button {
		appearance: none;
		margin: 0;
	}

	.tip-custom__suffix {
		color: var(--color-mute);
		font-size: 13px;
		font-weight: 600;
	}

	/* Tax Row */
	.tax-row {
		display: flex;
		align-items: center;
		gap: var(--spacing-sm);
		flex-wrap: wrap;
	}

	.tax-control {
		height: 38px;
	}

	.tax-presets {
		display: flex;
		align-items: center;
		gap: 6px;
	}

	.tax-preset-btn,
	.people-preset-btn {
		height: 32px;
		padding: 0 12px;
		border: 1px solid var(--color-hairline);
		border-radius: var(--rounded-pill);
		background-color: var(--color-canvas-soft);
		color: var(--color-ink);
		font-family: var(--font-sans);
		font-size: 13px;
		font-weight: 600;
		cursor: pointer;
		transition: border-color 0.15s ease, background-color 0.15s ease;
	}

	.tax-preset-btn:hover,
	.people-preset-btn:hover {
		border-color: var(--color-hairline-strong);
		background-color: var(--surface-3);
	}

	/* Stepper (People) */
	.stepper-wrap {
		display: flex;
		align-items: center;
		gap: var(--spacing-sm);
		flex-wrap: wrap;
	}

	.stepper {
		display: inline-flex;
		align-items: center;
		border: 1.5px solid var(--color-hairline);
		border-radius: var(--rounded-xl); /* 24px */
		background-color: var(--color-canvas);
		overflow: hidden;
	}

	.stepper button {
		width: 42px;
		height: 40px;
		border: 0;
		background-color: var(--color-canvas-soft);
		color: var(--color-ink);
		font-family: var(--font-sans);
		font-size: 18px;
		font-weight: 700;
		cursor: pointer;
		transition: background-color 0.15s ease;
	}

	.stepper button:hover {
		background-color: var(--surface-3);
	}

	.stepper input {
		width: 54px;
		height: 40px;
		padding: 0;
		border: 0;
		border-left: 1.5px solid var(--color-hairline);
		border-right: 1.5px solid var(--color-hairline);
