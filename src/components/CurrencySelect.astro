---
import { CURRENCIES, CURRENCY_REGIONS } from '../data/currencies';

interface Props {
	id: string;
	name?: string;
	label?: string;
	class?: string;
	compact?: boolean;
}

const {
	id,
	name = 'currency',
	label = 'Currency',
	class: className = '',
	compact = false,
} = Astro.props;
---

<label class={`currency ${className}`} for={id}>
	<span class="sr-only">{label}</span>
	<select id={id} name={name} data-stc-currency aria-label={label}>
		{
			CURRENCY_REGIONS.map((region) => (
				<optgroup label={region}>
					{CURRENCIES.filter((currency) => currency.region === region).map((currency) => (
						<option value={currency.code}>
							{compact ? `${currency.symbol} ${currency.code}` : `${currency.symbol} ${currency.code} — ${currency.name}`}
						</option>
					))}
				</optgroup>
			))
		}
	</select>
	<svg
		class="currency__chevron"
		aria-hidden="true"
		width="12"
		height="12"
		viewBox="0 0 12 12"
		fill="none"
		xmlns="http://www.w3.org/2000/svg"
	>
		<path
			d="M3 4.5 6 7.5 9 4.5"
			stroke="currentColor"
			stroke-width="1.5"
			stroke-linecap="round"
			stroke-linejoin="round"></path>
	</svg>
</label>

<style>
	.currency {
		position: relative;
		display: inline-flex;
		align-items: center;
		min-width: 0;
	}

	.currency select {
		appearance: none;
		-webkit-appearance: none;
		width: 100%;
		height: 36px;
		max-width: 190px;
		padding: 0 30px 0 12px;
		border: 1px solid var(--hairline);
		border-radius: var(--r-sm);
		background: var(--surface);
		color: var(--ink);
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 500;
		letter-spacing: 0.02em;
		cursor: pointer;
		text-overflow: ellipsis;
		transition:
			border-color 0.15s ease,
			background-color 0.15s ease;
	}

	.currency select:hover {
		border-color: var(--hairline-strong);
	}

	.currency__chevron {
		position: absolute;
		right: 11px;
		pointer-events: none;
		color: var(--mute);
	}
</style>
