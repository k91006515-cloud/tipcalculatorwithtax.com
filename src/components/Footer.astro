---
const year = new Date().getFullYear();

const columns = [
	{
		title: 'Calculator',
		links: [
			{ label: 'Tip calculator', href: '/#calculator' },
			{ label: 'How it works', href: '/#how-it-works' },
			{ label: 'Tip guide', href: '/#tip-guide' },
			{ label: 'FAQ', href: '/#faq' },
		],
	},
	{
		title: 'Tools',
		links: [
			{ label: 'Bill splitter', href: '/#calculator' },
			{ label: 'Currency support', href: '/#features' },
			{ label: 'Dark mode', href: '/#features' },
			{ label: 'Keyboard friendly', href: '/#features' },
			{ label: 'Currency', href: '/#calculator' },
		],
	},
	{
		title: 'Legal',
		links: [
			{ label: 'Privacy policy', href: '/privacy/' },
			{ label: 'Terms of use', href: '/terms/' },
		],
	},
	{
		title: 'Company',
		links: [
			{ label: 'About us', href: '/about/' },
			{ label: 'Contact us', href: '/contact/' },
		],
	},
];
---

<footer class="footer">
	<div class="container footer__inner">
		<div class="footer__brand">
			<a class="footer__logo" href="/">
				<img
					src="/favicon-96x96.png"
					width="18"
					height="18"
					alt="Tip Calculator With Tax favicon"
					aria-hidden="true"
				/>
				<span>Tip Calculator With Tax</span>
			</a>
			<p class="footer__blurb">
				Calculate tips, split the bill, and know exactly what each person owes — in any currency,
				on any device.
			</p>
		</div>

		{
			columns.map((column) => (
				<nav class="footer__column" aria-label={column.title}>
					<h2 class="footer__heading">{column.title}</h2>
					<ul>
						{column.links.map((link) => (
							<li>
								<a href={link.href}>{link.label}</a>
							</li>
						))}
					</ul>
				</nav>
			))
		}
	</div>

	<div class="container footer__bottom">
		<p>© {year} Tip Calculator With Tax. All rights reserved.</p>
		<p class="footer__note">Free to use. No sign-up, no tracking of your amounts.</p>
	</div>
</footer>

<style>
	.footer {
		margin-top: var(--s-4xl);
		border-top: 1px solid var(--hairline);
		background: var(--canvas);
	}

	.footer__inner {
		display: grid;
		grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr));
		gap: var(--s-xl);
		padding-block: var(--s-3xl) var(--s-xl);
	}

	.footer__logo {
		display: inline-flex;
		align-items: center;
		gap: var(--s-xs);
		color: var(--ink);
		font-size: 15px;
		font-weight: 600;
		letter-spacing: -0.2px;
	}

	.footer__logo:hover {
		color: var(--ink);
	}

	.footer__blurb {
		max-width: 340px;
		margin-top: var(--s-md);
		font-size: 14px;
		line-height: 20px;
		color: var(--body);
	}

	.footer__heading {
		margin: 0 0 var(--s-md);
		color: var(--ink);
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.footer__column ul {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.footer__column a {
		display: inline-block;
		padding-block: 4px;
		color: var(--body);
		font-size: 14px;
		line-height: 20px;
	}

	.footer__column a:hover {
		color: var(--ink);
	}

	.footer__bottom {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--s-sm);
		padding-block: var(--s-lg);
		border-top: 1px solid var(--hairline);
		color: var(--mute);
		font-size: 13px;
	}

	@media (max-width: 880px) {
		.footer__inner {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--s-xl) var(--s-lg);
		}

		.footer__brand {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 520px) {
		.footer__inner {
			grid-template-columns: 1fr;
		}
	}
</style>
