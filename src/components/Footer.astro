---
const year = new Date().getFullYear();
---

<footer class="footer" role="contentinfo">
	<div class="container footer__inner">
		<div class="footer__brand">
			<a class="footer__logo" href="/" aria-label="Tip Calculator With Tax home">
				<span class="footer__logo-mark" aria-hidden="true">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
						<rect width="24" height="24" rx="6" fill="#9fe870" />
						<path d="M7 12h10M12 7v10" stroke="#0e0f0c" stroke-width="2.2" stroke-linecap="round"/>
						<circle cx="17" cy="7" r="1.5" fill="#0e0f0c" />
					</svg>
				</span>
				<span class="footer__brand-title" data-i18n="navBrand">Tip Calculator With Tax</span>
			</a>
			<p class="footer__blurb" data-i18n="footerBlurb">
				Free, private, and accurate tip calculator with sales tax support and multi-person bill splitting for 40+ world currencies.
			</p>
			<div class="footer__badge">
				<span class="badge-positive">
					<span class="footer__dot"></span>
					<span>100% Private & Client-side</span>
				</span>
			</div>
		</div>

		<nav class="footer__column" aria-label="Calculator links">
			<h2 class="footer__heading" data-i18n="footerColCalc">Calculator</h2>
			<ul>
				<li><a href="/#calculator" data-i18n="navCalculator">Tip Calculator</a></li>
				<li><a href="/#how-it-works" data-i18n="navHowItWorks">How it works</a></li>
				<li><a href="/#tip-guide" data-i18n="navTipGuide">Tip guide</a></li>
				<li><a href="/#faq" data-i18n="navFaq">FAQ</a></li>
			</ul>
		</nav>

		<nav class="footer__column" aria-label="Tools and features">
			<h2 class="footer__heading" data-i18n="footerColTools">Tools & Features</h2>
			<ul>
				<li><a href="/#calculator" data-i18n="footerBillSplitter">Bill Splitter</a></li>
				<li><a href="/#calculator" data-i18n="footerCurrencies">40+ Currencies</a></li>
				<li><a href="/#features" data-i18n="footerDarkMode">Dark Mode</a></li>
			</ul>
		</nav>

		<nav class="footer__column" aria-label="Legal and company">
			<h2 class="footer__heading" data-i18n="footerColLegal">Legal</h2>
			<ul>
				<li><a href="/privacy/" data-i18n="footerPrivacy">Privacy Policy</a></li>
				<li><a href="/terms/" data-i18n="footerTerms">Terms of Use</a></li>
				<li><a href="/about/" data-i18n="footerAbout">About Us</a></li>
				<li><a href="/contact/" data-i18n="footerContact">Contact Us</a></li>
			</ul>
		</nav>
	</div>

	<div class="container footer__bottom">
		<p>© {year} Tip Calculator With Tax. <span data-i18n="footerRights">All rights reserved.</span></p>
		<p class="footer__note" data-i18n="footerNote">Free to use. 100% private — no sign-up, no tracking of amounts.</p>
	</div>
</footer>

<style>
	/* footer: Background {colors.ink}, text {colors.canvas-soft}, padding {spacing.3xl} {spacing.xl} (DESIGN.md) */
	.footer {
		margin-top: 0;
		background-color: var(--color-ink);
		color: var(--color-canvas-soft);
		font-family: var(--font-sans);
		font-size: 14px;
		line-height: 20px;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
	}

	.footer__inner {
		display: grid;
		grid-template-columns: minmax(0, 1.8fr) repeat(3, minmax(0, 1fr));
		gap: var(--spacing-2xl);
		padding-block: var(--spacing-3xl) var(--spacing-xl);
	}

	.footer__brand {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md);
	}

	.footer__logo {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: #ffffff;
		font-family: var(--font-display);
		font-size: 17px;
		font-weight: 900;
		letter-spacing: -0.02em;
		text-decoration: none;
	}

	.footer__logo:hover {
		color: var(--color-primary);
		opacity: 1;
	}

	.footer__logo-mark {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.footer__brand-title {
		color: #ffffff;
	}

	.footer__blurb {
		max-width: 380px;
		font-size: 14px;
		line-height: 22px;
		color: #b5baa8;
		margin: 0;
	}

	.footer__badge {
		margin-top: var(--spacing-xs);
	}

	.footer__dot {
		width: 6px;
		height: 6px;
		border-radius: var(--rounded-full);
		background-color: var(--color-positive);
	}

	.footer__heading {
		margin: 0 0 var(--spacing-md);
		color: #ffffff;
		font-family: var(--font-sans);
		font-size: 13px;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.footer__column ul {
		display: flex;
		flex-direction: column;
		gap: 8px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.footer__column a {
		display: inline-block;
		padding-block: 2px;
		color: #b5baa8;
		font-size: 14px;
		line-height: 20px;
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.footer__column a:hover {
		color: var(--color-primary);
		opacity: 1;
		text-decoration: none;
	}

	.footer__bottom {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-sm);
		padding-block: var(--spacing-lg);
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		color: #848a7b;
		font-size: 13px;
	}

	.footer__bottom p {
		margin: 0;
	}

	@media (max-width: 880px) {
		.footer__inner {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--spacing-xl) var(--spacing-lg);
		}

		.footer__brand {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 520px) {
		.footer__inner {
			grid-template-columns: 1fr;
		}
	}
</style>
